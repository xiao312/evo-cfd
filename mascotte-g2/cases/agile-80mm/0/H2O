FoamFile
{
    version     2.0;
    format      binary;
    class       volScalarField;
    location    "0";
    object      H2O;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    geom
    {
        type            zeroGradient;
    }
    slipwalls
    {
        type            zeroGradient;
    }
    noslipwalls
    {
        type            zeroGradient;
    }
    ch4inlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    loxinlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    axisymmetric
    {
        type            symmetry;
    }
    outlet
    {
        type            zeroGradient;
    }
    planeMinus
    {
        type            wedge;
    }
    planePlus
    {
        type            wedge;
    }
}


