FoamFile
{
    version         2;
    format          binary;
    class           volVectorField;
    location        "0";
    object          U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 1 -1 0 0 0 0 ];

internalField   uniform ( 0 0 0 );

boundaryField
{
    geom
    {
        type            noSlip;
    }
    slipwalls
    {
        type            slip;
    }
    noslipwalls
    {
        type            noSlip;
    }
    ch4inlet
    {
        type            flowRateInletVelocity;
        massFlowRate    table ( ( 0 0 ) ( 5e-05 0.0019875 ) ( 1 0.0019875 ) );
        rho             rho;
        rhoInlet        42.9947;
        extrapolateProfile no;
        value           uniform ( 0 0 0 );
    }
    loxinlet
    {
        type            flowRateInletVelocity;
        // 44.4 g/s full annulus scaled by the 5-degree wedge (5/360).
        massFlowRate    table ( ( 0 0 ) ( 5e-05 0.000616666666666667 ) ( 1 0.000616666666666667 ) );
        rho             rho;
        rhoInlet        1328.24;
        extrapolateProfile no;
        value           uniform ( 0 0 0 );
    }
    axisymmetric
    {
        type            symmetry;
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform ( 0 0 0 );
    }
    planeMinus
    {
        type            wedge;
    }
    planePlus
    {
        type            wedge;
    }
}


