{
  "comment": "Committed egress topology: fixed ports and capability grants. Secrets never go here.",
  "llm": {
    "listen_host": "127.0.0.1",
    "listen_port": 18080,
    "upstream": "https://discovery-api.intern-ai.org.cn/v1",
    "provider": "intern-ai"
  },
  "web": {
    "listen_host": "127.0.0.1",
    "listen_port": 18081
  },
  "tunnel": {
    "bind_host": "172.17.0.1",
    "remote_user": "evocfd-tunnel"
  },
  "profiles": {
    "offline": { "llm": false, "web": false },
    "llm-only": { "llm": true, "web": false },
    "llm+web": { "llm": true, "web": true }
  }
}
